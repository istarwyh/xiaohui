{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "4.4.0",
  "type": "module",
  "author": "talk@xiaohui.cool",
  "license": "MIT",
  "homepage": "https://xiaohui.cool",
  "repository": {
    "type": "git",
    "url": "https://github.com/istarwyh/xiaohui.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "docs": "npx quartz build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "node --import tsx --test ./quartz/util/path.test.ts ./quartz/depgraph.test.ts ./quartz/util/feedImage.test.ts ./quartz/components/scripts/spa.test.ts ./quartz/util/homePageModel.test.ts ./quartz/util/translations.test.ts ./quartz/components/scripts/feedList.test.ts ./quartz/components/scripts/search.helpers.test.ts ./quartz/components/scripts/search.test.ts ./quartz/components/scripts/copyPage.test.ts ./quartz/components/pages/Content.test.ts ./quartz/components/scripts/sharePoster.test.ts ./quartz/design/homePage.test.ts && node --test ./scripts/update-homepage.test.js ./scripts/lib/frontmatter.test.js && npm run check:design",
    "test:share-browser": "playwright test tests/browser/sharePoster.spec.mjs --workers=1",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "update-homepage": "node ./scripts/update-homepage.js",
    "sync": "npm run update-homepage && npx quartz sync",
    "build": "git fetch --unshallow || git fetch --all --tags --force --prune || true && npx quartz build && cp -r extra-pages/* public/",
    "build:cf": "npm run build",
    "backfill:dates": "node ./scripts/backfill-frontmatter-dates.js",
    "check:frontmatter": "node ./scripts/check-frontmatter.js --all",
    "postinstall": "node ./scripts/check-git-deps.js && (bash ./scripts/install-hooks.sh || true)",
    "check:design": "node --import tsx --test ./quartz/design/tokens.test.ts ./quartz/design/brandAssets.test.ts ./quartz/design/brandPage.test.ts"
  },
  "engines": {
    "npm": ">=9.3.1",
    "node": "20 || >=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@floating-ui/dom": "^1.8.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.2.0",
    "@tweenjs/tween.js": "^25.0.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "cli-spinner": "^0.2.10",
    "d3": "^7.9.0",
    "esbuild-sass-plugin": "^3.7.0",
    "flexsearch": "0.8.212",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.4",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "is-absolute-url": "^5.0.0",
    "js-yaml": "^5.4.2",
    "lightningcss": "^1.33.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.1.0",
    "micromorph": "^0.4.5",
    "pixi.js": "^8.22.0",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0",
    "pretty-bytes": "^7.2.0",
    "pretty-time": "^1.1.0",
    "qrcode": "^1.5.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-mathjax": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "rfdc": "^1.4.1",
    "rimraf": "^6.1.3",
    "satori": "^0.35.0",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "source-map-support": "^0.5.21",
    "three": "^0.186.1",
    "to-vfile": "^8.0.0",
    "toml": "^5.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.22.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/cli-spinner": "^0.2.3",
    "@types/d3": "^7.4.3",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/pretty-time": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/source-map-support": "^0.5.10",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/simple-git-darwin-arm64": "1.2.0",
    "@napi-rs/simple-git-darwin-x64": "1.2.0",
    "@napi-rs/simple-git-linux-x64-gnu": "1.2.0",
    "@napi-rs/simple-git-win32-x64-msvc": "1.2.0"
  },
  "overrides": {
    "yargs": "$yargs"
  }
}

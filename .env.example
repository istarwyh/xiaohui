# Unsplash API Configuration
# Get your API key from https://unsplash.com/developers
# This is optional - the script will use pre-selected photo IDs if not set
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# WebMCP progressive enhancement (export this variable in the build environment)
# Keep disabled until the target browser/Agent integration is validated.
QUARTZ_ENABLE_WEBMCP=0

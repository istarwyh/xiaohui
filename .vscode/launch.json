{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Quartz Build",
        "skipFiles": ["<node_internals>/**"],
        "runtimeExecutable": "npx",
        "runtimeArgs": ["quartz"],
        "args": ["build", "--verbose"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "sourceMaps": true
      }
    ]
  }